# ── Storage ─────────────────────────────────────────────────────────────────
# Host directory that backs every persistent service in the main stack
# (neo4j, oxigraph, sparql-proxy, extractor, portainer, grimoirelab-db). Each
# service gets its own subdirectory under this root. Default is the shared
# `data/` directory at the open-pulse repo root (gitignored) — resolved as
# `../../data` because the compose file lives at `infra/compose/`. The
# grimoire stack at `infra/grimoirelab/` writes to the same root under
# `data/grimoirelab/` so the two stacks coexist without colliding.
OPEN_PULSE_DATA_DIR=./data

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=neo4j/openpulse-dev-password
NEO4J_PLUGINS=["graph-data-science","apoc"]
NEO4J_UNRESTRICTED=apoc.*
NEO4J_ALLOWLIST=apoc.*

ANALYSIS_NOTEBOOK_PORT=8888

GRIMOIRELAB_DB_USER=grimoire
GRIMOIRELAB_DB_PASSWORD=grimoire
GRIMOIRELAB_DB_NAME=grimoirelab

PORTAINER_PORT=7508
PORTAINER_HASHED_PASSWORD=$$2y$$10$$replace-with-bcrypt-hash

# SPARQL stack (sparql profile)
# OXIGRAPH_PORT is only used by the standalone compose at infra/services/oxigraph/.
# In the main stack, Oxigraph is reachable only via the sparql-proxy.
OXIGRAPH_PORT=7878
SPARQL_PROXY_PORT=7878

# Single image for the CLI/orchestrator container AND the hub dashboard —
# both roles run from the same `open-pulse` image, with the role selected by
# `command:` / `entrypoint:` overrides in compose. Override to pin a tag,
# or to point at a locally built image:
#   docker build -f tools/images/Dockerfile-open-pulse -t open-pulse:local .
#   OPEN_PULSE_IMAGE=open-pulse:local
OPEN_PULSE_IMAGE=ghcr.io/sdsc-ordes/open-pulse:latest

# --- Crawler service (opt-in via --profile crawler) ---
# Bearer token clients must send to the crawler API. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
CRAWLER_API_TOKEN=
# GitHub PAT(s) the crawler uses to call the GitHub API. Comma-separated for multi-token rotation.
CRAWLER_GITHUB_TOKEN=
# Override to pin a specific crawler image tag.
# CRAWLER_IMAGE=ghcr.io/sdsc-ordes/open-pulse-crawler:0.x.y
# Override the host port (defaults to 8000).
# CRAWLER_PORT=8000

# --- Extractor service (opt-in via --profile extractor) ---
#
# Pulls ghcr.io/imaging-plaza/git-metadata-extractor by default. The package is
# currently published as PRIVATE — you need a GHCR PAT with read:packages and
# `docker login ghcr.io -u <gh-user>` before `compose up`. Once the package is
# made public, this auth step goes away.
#
# At least one LLM provider key must be set. The app picks via EXTRACTOR_PROVIDER.
EXTRACTOR_OPENAI_API_KEY=
EXTRACTOR_OPENROUTER_API_KEY=
# GitHub PAT — required (the extractor calls the GitHub API for every repo).
EXTRACTOR_GITHUB_TOKEN=
# Optional: GitLab PAT and EPFL Infoscience token for non-GitHub sources.
EXTRACTOR_GITLAB_TOKEN=
EXTRACTOR_INFOSCIENCE_TOKEN=
# LLM model + provider. Defaults: gpt-4o-mini via openai.
# EXTRACTOR_MODEL=gpt-4o-mini
# EXTRACTOR_PROVIDER=openai
# Tuning knobs (defaults are sensible for a dev box).
# EXTRACTOR_MAX_CACHE_ENTRIES=5000
# EXTRACTOR_MAX_SELENIUM_SESSIONS=1
# EXTRACTOR_WORKERS=2
# Override to pin a specific extractor image tag.
# EXTRACTOR_IMAGE=ghcr.io/imaging-plaza/git-metadata-extractor:0.x.y
# Override the host port (defaults to 1234).
# EXTRACTOR_PORT=1234

# --- Hub: control-plane dashboard (opt-in via --profile hub) ---
# Single shared password. The dashboard is single-tenant — anyone who knows
# this password can read state and start/stop services. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
HUB_AUTH=
# Override the host port (defaults to 9090).
# HUB_PORT=9090
# (Image is set globally above via OPEN_PULSE_IMAGE — same image runs both
# the CLI/orchestrator container and the hub.)
# Override service URLs the hub reaches in-network (only needed for
# non-default deployments).
# HUB_APPLIER_URL=http://projects-applier:8000
# HUB_SPARQL_URL=http://sparql-proxy:7878
# HUB_NEO4J_URL=bolt://neo4j:7687
# HUB_KIBITER_URL=http://localhost:7508

# --- Grimoirelab stack (opt-in via `open-pulse deploy up --with-grimoire`) ---
# When you bring the grimoirelab stack up alongside the main stack, the variables
# below are also required. The defaults below mirror infra/grimoirelab/.env.dist
# and are safe for local dev — change passwords and APPLIER_AUTH for anything
# beyond your laptop. APPLIER_AUTH gates the projects.json applier sidecar
# (generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))').
APPLIER_AUTH=
MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes
OPENSEARCH_URL=https://opensearch-node1:9200
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601
OPENSEARCH_HOSTS=["https://opensearch-node1:9200"]
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
SORTINGHAT_SECRET_KEY=change-me
SORTINGHAT_HOST=nginx
SORTINGHAT_PORT=8000
SORTINGHAT_DB_HOST=mariadb
SORTINGHAT_DB_PORT=3306
SORTINGHAT_DB_DATABASE=sortinghat_db
SORTINGHAT_DB_USER=root
SORTINGHAT_DB_PASSWORD=
SORTINGHAT_REDIS_HOST=valkey
SORTINGHAT_REDIS_PASSWORD=
SORTINGHAT_SUPERUSER_USERNAME=admin
SORTINGHAT_SUPERUSER_PASSWORD=change-me
SORTINGHAT_ALLOWED_HOST=sortinghat,nginx,localhost,127.0.0.1,[::1]
SORTINGHAT_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
KIBANA_HOST=http://opensearch-dashboards:5601/
GITHUB_API_TOKEN=replace-me
GITLAB_API_TOKEN=
GRIMOIRE_ENABLE_GIT_PULL=true
GRIMOIRE_INTAKE_CRON_SCHEDULE=*/5 * * * *
# GRIMOIRE_DATA_DIR overrides the per-stack data root; defaults to
# ../../data/grimoirelab (relative to infra/grimoirelab/).
# GRIMOIRE_DATA_DIR=../../data/grimoirelab
