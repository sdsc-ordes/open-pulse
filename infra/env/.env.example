NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_AUTH=neo4j/openpulse-dev-password
NEO4J_PLUGINS=["graph-data-science","apoc"]
NEO4J_UNRESTRICTED=apoc.*
NEO4J_ALLOWLIST=apoc.*

ANALYSIS_NOTEBOOK_PORT=8888

GRIMOIRELAB_DB_USER=grimoire
GRIMOIRELAB_DB_PASSWORD=grimoire
GRIMOIRELAB_DB_NAME=grimoirelab

PORTAINER_PORT=7508
PORTAINER_HASHED_PASSWORD=$$2y$$10$$replace-with-bcrypt-hash

# SPARQL stack (sparql profile)
# OXIGRAPH_PORT is only used by the standalone compose at infra/services/oxigraph/.
# In the main stack, Oxigraph is reachable only via the sparql-proxy.
OXIGRAPH_PORT=7878
SPARQL_PROXY_PORT=7878

OPEN_PULSE_CLI_IMAGE=ghcr.io/open-pulse/open-pulse:latest

# --- Crawler service (opt-in via --profile crawler) ---
# Bearer token clients must send to the crawler API. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
CRAWLER_API_TOKEN=
# GitHub PAT(s) the crawler uses to call the GitHub API. Comma-separated for multi-token rotation.
CRAWLER_GITHUB_TOKEN=
# Override to pin a specific crawler image tag.
# CRAWLER_IMAGE=ghcr.io/sdsc-ordes/open-pulse-crawler:0.x.y
# Override the host port (defaults to 8000).
# CRAWLER_PORT=8000

# --- Extractor service (opt-in via --profile extractor) ---
#
# Pulls ghcr.io/imaging-plaza/git-metadata-extractor by default. The package is
# currently published as PRIVATE — you need a GHCR PAT with read:packages and
# `docker login ghcr.io -u <gh-user>` before `compose up`. Once the package is
# made public, this auth step goes away.
#
# At least one LLM provider key must be set. The app picks via EXTRACTOR_PROVIDER.
EXTRACTOR_OPENAI_API_KEY=
EXTRACTOR_OPENROUTER_API_KEY=
# GitHub PAT — required (the extractor calls the GitHub API for every repo).
EXTRACTOR_GITHUB_TOKEN=
# Optional: GitLab PAT and EPFL Infoscience token for non-GitHub sources.
EXTRACTOR_GITLAB_TOKEN=
EXTRACTOR_INFOSCIENCE_TOKEN=
# LLM model + provider. Defaults: gpt-4o-mini via openai.
# EXTRACTOR_MODEL=gpt-4o-mini
# EXTRACTOR_PROVIDER=openai
# Tuning knobs (defaults are sensible for a dev box).
# EXTRACTOR_MAX_CACHE_ENTRIES=5000
# EXTRACTOR_MAX_SELENIUM_SESSIONS=1
# EXTRACTOR_WORKERS=2
# Override to pin a specific extractor image tag.
# EXTRACTOR_IMAGE=ghcr.io/imaging-plaza/git-metadata-extractor:0.x.y
# Override the host port (defaults to 1234).
# EXTRACTOR_PORT=1234
