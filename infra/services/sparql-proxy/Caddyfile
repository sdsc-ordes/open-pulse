# Caddyfile for the SPARQL reverse proxy.
#
# Always-protected writes on /update and /store (admin credential).
# Reads on `/` (YASGUI UI) and `/query` are gated BY DEFAULT — the
# compose service ships ``SPARQL_READ_AUTH_PATHS=/ /query /query/*``,
# which this Caddyfile re-applies as a fallback when the env var
# isn't passed. Set ``SPARQL_READ_AUTH_PATHS=__off__`` in ``infra/.env``
# to expose reads anonymously.
#
# Users come from /etc/caddy/users/{admin,reader}/* (mounted from
# infra/services/sparql-proxy/users in the host). One user per line:
# `user <bcrypt-hash>`. The hashes are generated by
# scripts/fix-data-perms.sh from SPARQL_AUTH and SPARQL_READER_AUTH.
#
# The admin API is enabled on the default localhost:2019 inside the
# container only (not exposed to the host). That's what powers
# `caddy reload` for hot-reloading users without restarting the container.
{
	auto_https off
}

:7878 {
	# ── Liveness probe ────────────────────────────────────────────────
	# Public (no auth, no data): just confirms Caddy is up. Lets Docker's
	# healthcheck succeed without exposing the auth-gated SPARQL surface.
	# Matched by its own `handle` so it terminates before the read-auth /
	# reverse-proxy directives below.
	handle /healthz {
		respond "ok" 200
	}

	# ── Static dashboard UI ───────────────────────────────────────────
	# Single-page BYOK dashboard for talking to Open Pulse services.
	# Mounted from infra/services/sparql-proxy/projects-ui in the host.
	handle /projects-ui {
		redir /projects-ui/ permanent
	}
	handle /projects-ui/* {
		uri strip_prefix /projects-ui
		root * /etc/caddy/projects-ui
		file_server browse
	}

	# ── SPARQL reverse-proxy ──────────────────────────────────────────
	#
	# Read-auth is delegated to the hub via `forward_auth`, so ONE reader
	# identity works both at the hub API and directly here: every hub reader
	# token (managed in Admin → Users), the env reader, the hub admin, AND
	# the store's own reader/admin passwords (so the hub's own internal
	# connection and any legacy consumer keep working). The hub endpoint
	# returns 204 (allow) / 401 (deny); on 401 Caddy relays the challenge to
	# the client. Full store access — per-token named-graph scope is enforced
	# only on the hub's own `/api/v1/query` path, by design.
	#
	# Wrapped in a `route` so the directives run in written order. Set
	# `SPARQL_READ_AUTH_PATHS=__off__` in `infra/.env` to expose reads
	# anonymously (the reads matcher then matches nothing, so forward_auth
	# is skipped).
	route {
		# Always-protected write paths — admin credential only.
		@writes {
			method POST PUT DELETE PATCH
			path /update /update/* /store /store/*
		}
		basic_auth @writes {
			import /etc/caddy/users/admin/*
		}

		# Reads (on by default) — delegated to the hub's token checkpoint.
		@reads_protected {
			path {$SPARQL_READ_AUTH_PATHS:/ /query /query/*}
		}
		forward_auth @reads_protected hub:8000 {
			uri /api/v1/system/store-auth
		}

		# Everything (matched or not) is forwarded to Oxigraph.
		reverse_proxy oxigraph:7878 {
			header_up Host {host}
		}
	}

	log {
		output stdout
		format console
	}
}
