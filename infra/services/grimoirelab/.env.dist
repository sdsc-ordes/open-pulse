# Copy this file to `.env` and replace placeholder values before running Docker Compose.

# ── Storage ─────────────────────────────────────────────────────────────────
# Host directory that backs every persistent service in this stack
# (mariadb, valkey, opensearch, mordred logs/perceval/cache/tmp, sortinghat
# static, projects-conf). Each service gets its own subdirectory under this
# root. Default is `../../../data/grimoirelab` — i.e. the shared `data/` at the
# open-pulse repo root, namespaced under `grimoirelab/` so it sits alongside
# the main stack data (neo4j, oxigraph, …) without collisions. The compose
# file lives at `infra/services/grimoirelab/`, hence three levels up. Override
# to point at any local path with enough disk — e.g. `/srv/grimoire-lab` for
# a dedicated partition.
GRIMOIRE_DATA_DIR=../../../data/grimoirelab

# ── Applier sidecar (Bring-Your-Own-Key projects.json dashboard) ────────────
# Bearer token required by the projects-applier sidecar. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
APPLIER_AUTH=
# Override the host port for the applier (default 1235).
# APPLIER_PORT=1235

MYSQL_ROOT_PASSWORD=
MYSQL_ALLOW_EMPTY_PASSWORD=yes

OPENSEARCH_URL=https://opensearch-node1:9200
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601
OPENSEARCH_HOSTS=["https://opensearch-node1:9200"]
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=change-me
OPENSEARCH_INITIAL_ADMIN_PASSWORD=change-me
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

SORTINGHAT_SECRET_KEY=change-me
SORTINGHAT_HOST=nginx
SORTINGHAT_PORT=8000
SORTINGHAT_DB_HOST=mariadb
SORTINGHAT_DB_PORT=3306
SORTINGHAT_DB_DATABASE=sortinghat_db
SORTINGHAT_DB_USER=root
SORTINGHAT_DB_PASSWORD=
SORTINGHAT_REDIS_HOST=valkey
SORTINGHAT_REDIS_PASSWORD=
SORTINGHAT_SUPERUSER_USERNAME=admin
SORTINGHAT_SUPERUSER_PASSWORD=change-me
SORTINGHAT_ALLOWED_HOST=sortinghat,nginx,localhost,127.0.0.1,[::1]
SORTINGHAT_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

KIBANA_HOST=http://opensearch-dashboards:5601/

GITHUB_API_TOKEN=<github-pat-redacted-from-history>
GITLAB_API_TOKEN=

GRIMOIRE_ENABLE_GIT_PULL=true
GRIMOIRE_INTAKE_CRON_SCHEDULE=*/5 * * * *
