# ── Open Pulse — infra / deployment config ────────────────────────────────
# Copy to `infra/.env` and fill in.
#
# This is the AUTHORITATIVE config for the local stack. When you launch
# from `infra/` (via `op deploy …` or raw `docker compose -f
# infra/open-pulse-stack/…`), compose reads ONLY this file. Every container
# in the stack pulls it via `env_file:`, so anything you set here is
# visible to every service.
#
# If you are using open-pulse purely as a CLIENT against established
# infrastructure (i.e. the open-pulse Python CLI / hub running on the host
# pointing at someone else's services), you do NOT need this file — use
# `<repo>/.env` instead. Compose never loads `<repo>/.env`.


# ── Storage ───────────────────────────────────────────────────────────────
# Host directory that backs every persistent service in the main stack.
# Use an ABSOLUTE path — relative paths resolve differently between
# `op deploy …` and raw `docker compose -f infra/open-pulse-stack/…`. The
# CLI auto-substitutes this line with the absolute repo-root data path
# when seeding `infra/.env` from this template.
#
# Examples:
#   OPEN_PULSE_DATA_DIR=/home/me/open-pulse/data
#   OPEN_PULSE_DATA_DIR=D:/open-pulse/data
#   OPEN_PULSE_DATA_DIR=/mnt/big-ssd/open-pulse-data
OPEN_PULSE_DATA_DIR=./data

# Absolute host path of this repo. Required by the CLI orchestrator
# container so its bind-mount root matches the host's filesystem layout
# inside and outside the container. Auto-substituted on seed (same as
# OPEN_PULSE_DATA_DIR above).
OPEN_PULSE_HOST_PATH=


# ── Image references ──────────────────────────────────────────────────────
# Single image used for the CLI orchestrator AND the hub. Override to pin
# a tag, or to point at a locally built image:
#   docker build -f tools/images/Dockerfile-open-pulse -t open-pulse:local .
#   OPEN_PULSE_IMAGE=open-pulse:local
OPEN_PULSE_IMAGE=ghcr.io/sdsc-ordes/open-pulse:latest

# Override to pin a specific crawler / extractor image tag.
# CRAWLER_IMAGE=ghcr.io/sdsc-ordes/open-pulse-crawler:0.x.y
# EXTRACTOR_IMAGE=ghcr.io/imaging-plaza/git-metadata-extractor:0.x.y


# ── Neo4j (default profile) ───────────────────────────────────────────────
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PLUGINS=["graph-data-science","apoc"]
NEO4J_UNRESTRICTED=apoc.*
NEO4J_ALLOWLIST=apoc.*
# JVM heap + page cache. Heap ≤ 50% of mem_limit so the rest is available
# for off-heap (page cache, GC overhead, native).
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m
NEO4J_MEM_LIMIT=2g
NEO4J_CPUS=2.0
# Default convention is `replace-me` for the password — change before any
# non-local deployment.
NEO4J_AUTH=neo4j/replace-me


# ── Hub (--profile hub) ───────────────────────────────────────────────────
HUB_PORT=9090
# Login at http://localhost:HUB_PORT with username `openpulse` (free-form;
# only the password is checked) and the password below.
HUB_AUTH=replace-me
# Override service URLs the hub reaches in-network (only needed for
# non-default deployments).
# HUB_APPLIER_URL=http://projects-applier:8000
# HUB_SPARQL_URL=http://sparql-proxy:7878
# HUB_NEO4J_URL=bolt://neo4j:7687
# HUB_KIBITER_URL=http://localhost:7508


# ── Crawler (--profile crawler) ───────────────────────────────────────────
# CRAWLER_PORT=8000
# Bearer token clients send to the crawler API.
CRAWLER_API_TOKEN=replace-me
# GitHub PAT(s) the crawler uses to call the GitHub API. Comma-separated
# for multi-token rotation. Required when --profile crawler is active.
CRAWLER_GITHUB_TOKEN=


# ── Extractor (--profile extractor) ───────────────────────────────────────
# EXTRACTOR_PORT=1234
# EXTRACTOR_MODEL=gpt-4o-mini
# EXTRACTOR_PROVIDER=openai
# EXTRACTOR_MAX_CACHE_ENTRIES=5000
# EXTRACTOR_MAX_SELENIUM_SESSIONS=1
# EXTRACTOR_WORKERS=2
# Server-side bearer the extractor v2 path requires be set (refuses with
# HTTP 503 if empty). The open-pulse client doesn't actually send this;
# it's a self-check on the extractor side.
EXTRACTOR_API_TOKEN=replace-me
# At least one LLM provider key required when --profile extractor is active.
EXTRACTOR_OPENAI_API_KEY=
EXTRACTOR_OPENROUTER_API_KEY=
# GitHub PAT — required (the extractor calls GitHub for every repo).
EXTRACTOR_GITHUB_TOKEN=
# Optional: GitLab PAT and EPFL Infoscience token for non-GitHub sources.
EXTRACTOR_GITLAB_TOKEN=
EXTRACTOR_INFOSCIENCE_TOKEN=
#
# ── gimie-api sidecar (develop ≥ 2026-06) ────────────────────────────────
# The GME develop image removed in-process gimie; repo extraction calls the
# gme-gimie-api sidecar. Leave GIMIE_API_URL empty to keep using an image
# that still bundles gimie. To switch to the sidecar:
#   1. pin GIMIE_API_IMAGE to the matching digest (the published :latest is
#      stale — exposes /gimie/project, not the /gimie/jsonld the GME calls);
#   2. set GIMIE_API_URL=http://gme-gimie-api:15400;
#   3. set GIMIE_GITHUB_TOKEN to a SINGLE GitHub PAT (gimie can't take the
#      comma-separated GME token pool);
#   4. recreate the extractor + gme-gimie-api.
# GIMIE_API_URL=
# GIMIE_API_IMAGE=ghcr.io/sdsc-ordes/gimie-api@sha256:<matching-digest>
# GIMIE_API_TIMEOUT_SECONDS=180
# GIMIE_API_PORT=7000
# GIMIE_GITHUB_TOKEN=
#
# ── new develop knobs ────────────────────────────────────────────────────
# V2_PACKAGE_REGISTRY_ENABLED=true   # npm/PyPI/conda/crates/RubyGems/Maven/Go/NuGet
# V2_REPO_SIGNALS_AGENT_MODE=apply   # LLM README enrichment: apply | shadow | off
# INDEX_BOOTSTRAP_ON_START=true      # create index DuckDB stores at startup
# Optional GitLab index tokens (public listings work without them):
# GITLAB_EPFL_TOKEN=
# GITLAB_ETHZ_TOKEN=
# GITLAB_DATASCIENCE_TOKEN=
# Any other extractor V2 / agent-runtime knobs (V2_*, RCP_TOKEN, HF_TOKEN,
# OPENALEX_MAILTO, EPFL_GRAPH_*, ORCID_*, INDEX_QDRANT_URL, …) can be set
# here too; the extractor service's `env_file:` directive injects the whole
# of `infra/.env` into the container, so any keys the extractor reads will
# pick them up automatically.
#
# Per-account fanout for user/org extractions (added in the develop image
# ~2026-05-22).  When false, user/org extractions keep their owned repos as
# references in pulse:owns — fast, no timeouts on big accounts.  Set to true
# to eagerly expand each owned repo (and respect the fanout caps below).
# V2_EXPAND_OWNED_REPOS=false
# V2_MAX_REPO_FANOUT_ORG=25
# V2_MAX_REPO_FANOUT_USER=50


# ── SPARQL stack (--profile sparql) ───────────────────────────────────────
# OXIGRAPH_PORT is only used by the standalone compose at
# infra/services/oxigraph/. In the main stack, Oxigraph is reachable only
# via the sparql-proxy.
OXIGRAPH_PORT=7878
SPARQL_PROXY_PORT=7878
# Format: username/password — used as HTTP Basic for SPARQL writes
# through the Caddy proxy. Match the user(s) defined in
# infra/services/sparql-proxy/users (bcrypt hashes).
SPARQL_AUTH=openpulse/replace-me

# Read auth — gated by default. The sparql-proxy ships with
#
#     SPARQL_READ_AUTH_PATHS=/ /query /query/*
#
# baked into the docker-compose service env, so the YASGUI UI at
# http://<host>:7502/ and the /query endpoint require the admin
# credential (SPARQL_AUTH) out of the box. Uncomment + set the
# variable below to override:
#
#  • Open up reads anonymously again (matches the old behaviour):
#       SPARQL_READ_AUTH_PATHS=__off__
#  • Protect only /query but leave the YASGUI UI public:
#       SPARQL_READ_AUTH_PATHS=/query /query/*
#  • Protect everything (the default):
#       SPARQL_READ_AUTH_PATHS=/ /query /query/*
#
# Optional separate reader credential — useful when you want to share
# read access without handing out the admin password (which also
# permits writes). Caddy accepts EITHER admin OR reader for gated
# read paths; only admin can hit /update and /store.
# SPARQL_READER_AUTH=reader/replace-me
# SPARQL_READ_AUTH_PATHS=/query /query/*


# ── Portainer (--profile orchestration) ───────────────────────────────────
# 7508 is reserved by the GrimoireLab nginx reverse-proxy (Kibiter UI). Use
# a different port for portainer.
PORTAINER_PORT=9000
PORTAINER_HASHED_PASSWORD=$$2y$$10$$replace-with-bcrypt-hash


# ── GrimoireLab DB (lightweight pair, --profile grimoirelab) ──────────────
GRIMOIRELAB_DB_USER=openpulse
GRIMOIRELAB_DB_PASSWORD=replace-me
GRIMOIRELAB_DB_NAME=grimoirelab


# ── Full GrimoireLab stack (--with-grimoire) ──────────────────────────────
APPLIER_AUTH=replace-me

MYSQL_ROOT_PASSWORD=replace-me
MYSQL_ALLOW_EMPTY_PASSWORD=no

OPENSEARCH_URL=https://opensearch-node1:9200
OPENSEARCH_DASHBOARDS_URL=http://opensearch-dashboards:5601
OPENSEARCH_HOSTS=["https://opensearch-node1:9200"]
# OpenSearch security plugin forces the admin user name to `admin`.
OPENSEARCH_USERNAME=admin
# OpenSearch enforces strong passwords (uppercase + lowercase + digit +
# special, min 8 chars). `Replace-Me-1!` is the placeholder that satisfies
# the regex; rotate before any non-local deployment.
OPENSEARCH_PASSWORD=Replace-Me-1!
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Replace-Me-1!
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

SORTINGHAT_SECRET_KEY=replace-me
SORTINGHAT_HOST=nginx
SORTINGHAT_PORT=8000
SORTINGHAT_DB_HOST=mariadb
SORTINGHAT_DB_PORT=3306
SORTINGHAT_DB_DATABASE=sortinghat_db
# MariaDB init uses root for schema creation; keep as-is.
SORTINGHAT_DB_USER=root
SORTINGHAT_DB_PASSWORD=replace-me
SORTINGHAT_REDIS_HOST=valkey
SORTINGHAT_REDIS_PASSWORD=replace-me
SORTINGHAT_SUPERUSER_USERNAME=openpulse
SORTINGHAT_SUPERUSER_PASSWORD=replace-me
SORTINGHAT_ALLOWED_HOST=sortinghat,nginx,localhost,127.0.0.1,[::1]
SORTINGHAT_CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

KIBANA_HOST=http://opensearch-dashboards:5601/
GRIMOIRE_ENABLE_GIT_PULL=true
GRIMOIRE_INTAKE_CRON_SCHEDULE=*/5 * * * *
# GRIMOIRE_DATA_DIR overrides the grimoirelab data root; defaults to
# ${OPEN_PULSE_DATA_DIR}/grimoirelab.
# GRIMOIRE_DATA_DIR=
# GitHub PATs Mordred uses for git/github backends.
GITHUB_API_TOKEN=
GITLAB_API_TOKEN=
# Optional: separate PAT for the grimoire intake cron sidecar.
# GRIMOIRE_GITHUB_TOKEN=

# Public hostname users hit in the browser. The hub builds every
# HUB_*_BROWSER_URL and HUB_*_DOCS_URL default by gluing this onto the
# host-published port. Override an individual URL below only if a service
# lives on a different host or sits behind a reverse proxy.
# HUB_PUBLIC_HOST=openpulse.epfl.ch
# HUB_NEO4J_BROWSER_URL=
# HUB_SPARQL_BROWSER_URL=
# HUB_OPENSEARCH_DASHBOARDS_URL=
# HUB_CRAWLER_DOCS_URL=
# HUB_EXTRACTOR_DOCS_URL=
