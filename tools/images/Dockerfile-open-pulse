FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

ARG UV_VERSION=0.8.15
ARG APP_USER=openpulse
ARG APP_UID=10001

RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --home-dir /home/${APP_USER} --shell /bin/bash --uid ${APP_UID} ${APP_USER}

RUN curl -LsSf https://astral.sh/uv/install.sh | sh -s -- --version ${UV_VERSION} \
    && mv /root/.local/bin/uv /usr/local/bin/uv \
    && mv /root/.local/bin/uvx /usr/local/bin/uvx

WORKDIR /app

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev --no-editable

COPY src/open_pulse ./src/open_pulse
RUN uv sync --frozen --no-dev \
    && chown -R ${APP_USER}:${APP_USER} /app

USER ${APP_USER}

ENTRYPOINT ["uv", "run", "open-pulse"]
CMD ["doctor"]
